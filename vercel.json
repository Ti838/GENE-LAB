{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/assets/(.*)", "destination": "/frontend/assets/$1" },
    { "source": "/css/(.*)", "destination": "/frontend/css/$1" },
    { "source": "/js/(.*)", "destination": "/frontend/js/$1" },
    { "source": "/pages/(.*)", "destination": "/frontend/pages/$1" },
    { "source": "/theme.css", "destination": "/frontend/theme.css" },
    { "source": "/", "destination": "/frontend/pages/index.html" },
    { "source": "/index.html", "destination": "/frontend/pages/index.html" },
    { "source": "/login", "destination": "/frontend/pages/login.html" },
    { "source": "/login.html", "destination": "/frontend/pages/login.html" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
