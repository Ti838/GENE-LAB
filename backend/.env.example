# ── GeneLab Backend — Environment Variables ──────────────────────────────────
# Copy this to .env and fill in your values
# On Railway: set these in the Variables tab of your service

# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas (required)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/GeneLab_PROD?retryWrites=true&w=majority

# JWT Session Security (required)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRY=24h

# Google OAuth (required for Google Sign-In)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Backend Public URL (required for asset URLs)
# Set to your Railway service domain e.g: https://genelab-backend.up.railway.app
BACKEND_URL=

# FastAPI Bioinformatics Service
# Set to your deployed bioservice Railway domain
FASTAPI_URL=https://genelab-bioservice.up.railway.app

# CORS — allowed frontend origin(s)
FRONTEND_URL=*

# Disable background job queues (set true if no Redis)
DISABLE_QUEUES=true

# Redis (only needed if DISABLE_QUEUES=false)
# REDIS_URL=redis://...
# REDIS_HOST=
# REDIS_PORT=6379

# AI Keys (optional)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Email (optional — for verification & password reset)
RESEND_API_KEY=

# NCBI BLAST (optional — higher rate limits)
NCBI_API_KEY=
